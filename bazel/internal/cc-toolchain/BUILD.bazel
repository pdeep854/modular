load("//bazel:config.bzl", "TOP_LEVEL_TAG")
load("//bazel/internal/cc-toolchain/features:features.bzl", "MARKER_FEATURES")  # buildifier: disable=bzl-visibility
load("//bazel/internal/cc-toolchain/tools:tools.bzl", "PLATFORMS")  # buildifier: disable=bzl-visibility
load(":sysroot_subset.bzl", "sysroot_subset")

package(default_visibility = ["//visibility:public"])

cc_sysroot(
    name = "linux_sysroot_aarch64",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = ["@sysroot-jammy-aarch64//sysroot:root"],
    data = ["@sysroot-jammy-aarch64//sysroot:directory"],
    sysroot = "@sysroot-jammy-aarch64//sysroot:root",
)

cc_sysroot(
    name = "linux_sysroot_x86_64",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = ["@sysroot-jammy-x86_64//sysroot:root"],
    data = ["@sysroot-jammy-x86_64//sysroot:directory"],
    sysroot = "@sysroot-jammy-x86_64//sysroot:root",
)

# The sysroot repository publishes its tree as a single opaque source
# directory, so an action that lists it as data gets all 37k files in the SDK.
# Locally that is one symlink; under remote execution every file lands in the
# action's input tree, on every action. Match what each action class reads
# instead.
#
# The framework list is derived, not curated: it is the closure of every
# framework any first-party or external-repo source includes, followed through
# the SDK headers' own cross-framework includes. Both halves matter -- glfw
# reaches Carbon and metal-cpp reaches IOSurface, neither of which appears in
# our sources, and Carbon in turn pulls a dozen more. A missing entry surfaces
# as a file-not-found deep in an SDK header with nothing pointing back here, so
# regenerate the closure rather than appending whatever the last break named.
# A framework reaches every header three times -- Foo.framework/Headers,
# Versions/Current/Headers and Versions/A/Headers are one file behind a symlink
# chain -- and a remote action's input tree materializes each path separately.
# A compile reads headers through the top-level alias, so the Versions copies
# are dead weight there; a link needs them, because ld64 resolves a .tbd's
# re-exports by install name (Foundation re-exports
# .../CoreFoundation.framework/Versions/A/CoreFoundation) and looks that path
# up under the sysroot.
sysroot_subset(
    name = "macos_sysroot_compile_files",
    include = [
        "System/Library/Frameworks/**",
        "usr/include/**",
        "usr/lib/**",
    ],
    exclude = ["System/Library/Frameworks/**/Versions/**"],
    sysroot = "@sysroot-macos//sysroot:root",
)

# Library stubs only: a link resolves -l and -framework against these, and the
# headers are the bulk of the compile set.
sysroot_subset(
    name = "macos_sysroot_link_files",
    include = [
        "System/Library/Frameworks/**/*.tbd",
        "usr/lib/**",
    ],
    sysroot = "@sysroot-macos//sysroot:root",
)

# The two halves, as plain file sets, for consumers that need to reason about
# them outside the toolchain -- see mojo_test_environment, which stages what a
# test reads when it links Mojo at runtime. Empty off macOS, where the sysroot
# is a single directory that is not split.
filegroup(
    name = "sysroot_compile_files",
    srcs = select({
        "@platforms//os:macos": [":macos_sysroot_compile_files"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "sysroot_link_files",
    srcs = select({
        "@platforms//os:macos": [":macos_sysroot_link_files"],
        "//conditions:default": [],
    }),
)

cc_sysroot(
    name = "macos_sysroot_compile",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    allowlist_include_directories = ["@sysroot-macos//sysroot:root"],
    data = [":macos_sysroot_compile_files"],
    sysroot = "@sysroot-macos//sysroot:root",
)

cc_sysroot(
    name = "macos_sysroot_link",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    data = [":macos_sysroot_link_files"],
    sysroot = "@sysroot-macos//sysroot:root",
)

[
    cc_toolchain(
        name = "{}_clang_toolchain".format(platform),
        args = select({
            "//:linux_x86_64": [":linux_sysroot_x86_64"],
            "//:linux_aarch64": [":linux_sysroot_aarch64"],
            "@platforms//os:macos": [
                ":macos_sysroot_compile",
                ":macos_sysroot_link",
            ],
        }) + [
            "//bazel/internal/cc-toolchain/args:resource_dir_args",
            "//bazel/internal/cc-toolchain/args:compile_and_link_args",
            "//bazel/internal/cc-toolchain/args:compile_args",
            "//bazel/internal/cc-toolchain/args:cpp_compile_args",
            "//bazel/internal/cc-toolchain/args:link_args",
            "//bazel/internal/cc-toolchain/args:link_executable_args",
            "//bazel/internal/cc-toolchain/args:link_shared_library_args",
            "//bazel/internal/cc-toolchain/args/modular:first_party",
            "//bazel/internal/cc-toolchain/args/modular:third_party",
            "//bazel/internal/cc-toolchain/args:compile_warnings",
            "//bazel/internal/cc-toolchain/args:compile_warnings_as_errors",
            "//bazel/internal/cc-toolchain/args/modular:assertions",  # Comes after warnings to allow disabling them
            "//bazel/internal/cc-toolchain/args:ignore_unused_command_line_argument",
        ] + select({
            "@platforms//os:linux": [
                "@rules_cc//cc/toolchains/args/soname_flags:set_soname",
            ],
            "//conditions:default": [],
        }),
        artifact_name_patterns = select({
            "@platforms//os:macos": [
                ":macos-dylib-pattern",
                ":macos-tbd-pattern",
            ],
            "//conditions:default": [],
        }),
        compiler = "clang",
        enabled_features = select({
            # NOTE: Must come before default features which can override these
            "//:modular_config_asan": ["//bazel/internal/cc-toolchain/features:asan"],
            "//:modular_config_tsan": ["//bazel/internal/cc-toolchain/features:tsan"],
            "//:modular_config_ubsan": ["//bazel/internal/cc-toolchain/features:ubsan"],
            "//conditions:default": [],
        }) + [
            # Features where order doesn't matter
            "//bazel/internal/cc-toolchain/features:archive_param_file",
            "//bazel/internal/cc-toolchain/features:gcc_quoting_for_param_files",
            "//bazel/internal/cc-toolchain/features:module_maps",
            "//bazel/internal/cc-toolchain/features:non_opt_feature",
            "//bazel/internal/cc-toolchain/features:set_soname",
            "//bazel/internal/cc-toolchain/features:sysroot",
            "@rules_cc//cc/toolchains/args/preprocessor_defines:feature",
            "@rules_cc//cc/toolchains/args/random_seed:feature",
            "//bazel/internal/cc-toolchain/features:external_include_paths",

            # NOTE: Order matters, some flags must come before default flags
            "//bazel/internal/cc-toolchain/features:parse_headers_shim",
            "//bazel/internal/cc-toolchain/features:opt_feature",
            "@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features",
            "//bazel/internal/cc-toolchain/features:supports_start_end_lib",  # https://github.com/bazelbuild/rules_cc/issues/322
            "//bazel/internal/cc-toolchain/args/interface-libraries",
        ],
        known_features = [
            # Only optional features need to be included here
            "//bazel/internal/cc-toolchain/features:asan",
            "//bazel/internal/cc-toolchain/features:tsan",
            "//bazel/internal/cc-toolchain/features:ubsan",
            "//bazel/internal/cc-toolchain/features:dbg_stub",
            "//bazel/internal/cc-toolchain/features:fastbuild_stub",
            "//bazel/internal/cc-toolchain/features:opt_stub",
            "//bazel/internal/cc-toolchain/features:layering_check",
            "//bazel/internal/cc-toolchain/features:use_module_maps",
            "//bazel/internal/cc-toolchain/features:parse_headers",
            "@rules_cc//cc/toolchains/args/generate_linkmap:feature",
            "@rules_cc//cc/toolchains/args/thin_lto:feature",
        ] + [
            "//bazel/internal/cc-toolchain/features:" + name
            for name in MARKER_FEATURES
        ] + select({
            "@platforms//os:macos": [
                "//bazel/internal/cc-toolchain/features:generate_dsym",
            ],
            "//conditions:default": [],
        }),
        make_variables = select({
            "@platforms//os:macos": [":macos_stack_frame"],
            "//conditions:default": [],
        }),
        module_map = "//bazel/internal/cc-toolchain/tools:builtin_module_map",
        supports_header_parsing = True,
        tags = [TOP_LEVEL_TAG],  # Used below, unclear why this is needed
        tool_map = "//bazel/internal/cc-toolchain/tools:{}_tools".format(platform),
    )
    for platform in PLATFORMS
]

cc_artifact_name_pattern(
    name = "macos-dylib-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:dynamic_library",
    extension = ".dylib",
    prefix = "lib",
)

cc_artifact_name_pattern(
    name = "macos-tbd-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:interface_library",
    extension = ".tbd",
    prefix = "lib",
)

cc_make_variable(
    name = "macos_stack_frame",
    value = "-Wframe-larger-than=100000000 -Wno-vla",
    variable_name = "STACK_FRAME_UNLIMITED",
)

toolchain(
    name = "linux-aarch64-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    toolchain = ":linux-aarch64_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "linux-x86_64-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    toolchain = ":linux-x86_64_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "macos-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    toolchain = ":macos_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

##===----------------------------------------------------------------------===##
# Windows ARM64 cross toolchain (llvm-mingw, UCRT ABI).
#
# Kept separate from the toolchain above rather than added to `PLATFORMS`: that
# one's args and features select() on linux vs macos with no default branch, so
# reusing them fails analysis for a windows target. Keeping the two apart also
# guarantees this cannot perturb the Linux or macOS builds.
##===----------------------------------------------------------------------===##

cc_tool_map(
    name = "windows-arm64_tools",
    tags = ["manual"],
    tools = {
        "@rules_cc//cc/toolchains/actions:ar_actions": ":windows-arm64-llvm-ar",
        "@rules_cc//cc/toolchains/actions:assembly_actions": ":windows-arm64-clang",
        "@rules_cc//cc/toolchains/actions:c_compile": ":windows-arm64-clang",
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions": ":windows-arm64-clang++",
        "@rules_cc//cc/toolchains/actions:link_actions": ":windows-arm64-clang++",
        "@rules_cc//cc/toolchains/actions:objcopy_embed_data": ":windows-arm64-llvm-objcopy",
        "@rules_cc//cc/toolchains/actions:strip": ":windows-arm64-llvm-strip",
    },
)

cc_tool(
    name = "windows-arm64-clang",
    src = "@llvm-mingw//:bin/clang",
    data = ["@llvm-mingw//:driver_files"],
    tags = ["manual"],
)

cc_tool(
    name = "windows-arm64-clang++",
    src = "@llvm-mingw//:bin/clang++",
    data = ["@llvm-mingw//:driver_files"],
    tags = ["manual"],
)

cc_tool(
    name = "windows-arm64-llvm-ar",
    src = "@llvm-mingw//:bin/llvm-ar",
    data = ["@llvm-mingw//:archiver_files"],
    tags = ["manual"],
)

cc_tool(
    name = "windows-arm64-llvm-objcopy",
    src = "@llvm-mingw//:bin/llvm-objcopy",
    data = ["@llvm-mingw//:objcopy_files"],
    tags = ["manual"],
)

cc_tool(
    name = "windows-arm64-llvm-strip",
    src = "@llvm-mingw//:bin/llvm-strip",
    data = ["@llvm-mingw//:objcopy_files"],
    tags = ["manual"],
)

# The driver's default target is the linux host it runs on, so the triple has
# to be passed explicitly. Everything else (resource dir, mingw sysroot, ld.lld)
# it finds relative to itself, which is why those directories are allowlisted
# here instead of going through cc_sysroot. That self-discovery is only hermetic
# under -no-canonical-prefixes: by default the driver locates itself through
# /proc/self/exe, which resolves bazel's symlinks into the repo download cache
# and makes the discovered headers absolute paths the allowlist can never match.
cc_args(
    name = "windows-arm64_target_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = [
        "@llvm-mingw//:mingw_include",
        "@llvm-mingw//:resource_include",
    ],
    args = [
        "--target=aarch64-w64-windows-gnu",
        "-no-canonical-prefixes",
    ],
)

# Support/SymbolExport.h must not emit dllimport/dllexport when everything
# links into one static executable: dllimport on a definition in the same
# link unit is a hard error under clang.
cc_args(
    name = "windows-arm64_static_export_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-DMODULAR_NO_EXPORT"],
)

cc_args(
    name = "windows-arm64_runtime_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-fuse-ld=lld",
        "-rtlib=compiler-rt",
        "-unwindlib=libunwind",
    ],
)

cc_args(
    name = "windows-arm64_cpp_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = ["-stdlib=libc++"],
)

cc_args(
    name = "windows-arm64_cpp_std_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_compile_actions"],
    args = ["-std=c++20"],
)

cc_artifact_name_pattern(
    name = "windows-executable-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:executable",
    extension = ".exe",
    prefix = "",
)

cc_artifact_name_pattern(
    name = "windows-dynamic-library-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:dynamic_library",
    extension = ".dll",
    prefix = "",
)

cc_toolchain(
    name = "windows-arm64_clang_toolchain",
    args = [
        ":windows-arm64_target_args",
        ":windows-arm64_static_export_args",
        ":windows-arm64_cpp_args",
        ":windows-arm64_cpp_std_args",
        ":windows-arm64_runtime_args",
    ],
    artifact_name_patterns = [
        ":windows-executable-pattern",
        ":windows-dynamic-library-pattern",
    ],
    compiler = "clang",
    enabled_features = [
        "//bazel/internal/cc-toolchain/features:archive_param_file",
        "//bazel/internal/cc-toolchain/features:gcc_quoting_for_param_files",
        "@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    tool_map = ":windows-arm64_tools",
)

toolchain(
    name = "windows-arm64-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
    ],
    toolchain = ":windows-arm64_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# gazelle:ignore
cc_library(name = "empty_lib")

# Explicitly depend on the asan lib so that it appears in runfiles and works with 'bazel run'
cc_import(
    name = "asan_lib",
    shared_library = select({
        "//:linux_aarch64": "@clang-linux-aarch64//:lib/clang/23/lib/aarch64-unknown-linux-gnu/libclang_rt.asan.so",
        "//:linux_x86_64": "@clang-linux-x86_64//:lib/clang/23/lib/x86_64-unknown-linux-gnu/libclang_rt.asan.so",
        "@platforms//os:macos": "@clang-macos//:lib/clang/23/lib/darwin/libclang_rt.asan_osx_dynamic.dylib",
    }),
)

cc_import(
    name = "tsan_macos_lib",
    shared_library = "@clang-macos//:lib/clang/23/lib/darwin/libclang_rt.tsan_osx_dynamic.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

cc_import(
    name = "ubsan_macos_lib",
    shared_library = "@clang-macos//:lib/clang/23/lib/darwin/libclang_rt.ubsan_osx_dynamic.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

alias(
    name = "extra_lib",
    actual = select({
        "//:asan": ":asan_lib",
        "//:tsan_macos": ":tsan_macos_lib",
        "//:ubsan_macos": ":ubsan_macos_lib",
        "//conditions:default": ":empty_lib",
    }),
    tags = [TOP_LEVEL_TAG],  # Used from .bazelrc
)

filegroup(
    name = "coverage_support",
    srcs = [
        ":collect-cc-coverage.sh",
        "@bazel_tools//tools/test:coverage_support",
    ] + select({
        "//:linux_aarch64": [
            "@clang-linux-aarch64//:bin/llvm-cov",
            "@clang-linux-aarch64//:bin/llvm-profdata",
        ],
        "//:linux_x86_64": [
            "@clang-linux-x86_64//:bin/llvm-cov",
            "@clang-linux-x86_64//:bin/llvm-profdata",
        ],
        "@platforms//os:macos": [
            "@clang-macos//:bin/llvm-cov",
            "@clang-macos//:bin/llvm-profdata",
        ],
    }),
    tags = [TOP_LEVEL_TAG],  # Used from .bazelrc
)
