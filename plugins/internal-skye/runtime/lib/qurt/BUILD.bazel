# The queue transport driven end to end with no device: the real packer, the
# real drain, and a loopback where the vendor queue would be. Proves a launch
# that travelled over the queue is byte-for-byte the launch that would have
# travelled over the blocking invocation, that order survives both the union and
# the ring, that a flush runs launches neither early nor never, and that the
# drain refuses every frame it cannot trust.
cc_test(
    name = "npu_queue_transport_test",
    srcs = ["npu_queue_transport_test.cpp"],
    tags = ["no-mypy"],
    deps = [
        ":QuRTDeviceContext",
        "@@//MLRT:Driver/DeviceContextImpl",
        "@@//Support:Base",
        "@plugin//examples/hexagon-ondevice:npu_queue_drain",
    ],
)
