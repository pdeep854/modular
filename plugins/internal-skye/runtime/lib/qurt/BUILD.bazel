# NPU_STEP_ALLOC_POOL at the seam it moves: a freed chunk parks by exact size
# and re-issues address-stable instead of dying by rpcmem_free, so the vendor
# driver's byte-proportional first-presentation charge is paid once per
# process instead of once per step. Judged at the stand-in's own rpcmem
# counters: flag off (cold AND with a warm pool) is the raw path verbatim,
# reuse is same-address with no raw calls, buckets are exact-size, a pooled
# block dispatches byte-identically, and parking runs chunkFree's erasures
# verbatim (proven at the MAP_ONCE seam: park unmaps, reuse re-maps afresh).
cc_test(
    name = "npu_step_pool_test",
    srcs = ["npu_step_pool_test.cpp"],
    data = [":npu_fake_transport"],
    env = {
        # Parking is per chunk, so the test must see the exact chunk it asked
        # for, not a pooled arena above the seam being tested.
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "false",
        "NPU_FAKE_TRANSPORT": "$(rootpath :npu_fake_transport)",
    },
    tags = ["no-mypy"],
    deps = [
        ":QuRTDeviceContext",
        "@@//MLRT:Driver/DeviceContextImpl",
        "@@//Support:Base",
    ],
)

# MODULAR_NPU_MAP_ONCE at the seam it moves: one mapping per allocation for
# its whole life instead of one per call, in the only mode the vendor's
# fd-keyed bookkeeping accepts, with the flag-off arm as the in-binary negative
# control and the free/realloc lifecycle leg that catches a mapping outliving
# its buffer. Every leg runs three rounds: both hazards present intermittently.
cc_test(
    name = "npu_map_once_test",
    srcs = ["npu_map_once_test.cpp"],
    data = [":npu_fake_transport"],
    env = {
        # Mapping is per allocation, so the test must see the exact chunk it
        # asked for, not a pooled arena.
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "false",
        "NPU_FAKE_TRANSPORT": "$(rootpath :npu_fake_transport)",
    },
    tags = ["no-mypy"],
    deps = [
        ":QuRTDeviceContext",
        "@@//MLRT:Driver/DeviceContextImpl",
        "@@//Support:Base",
    ],
)

