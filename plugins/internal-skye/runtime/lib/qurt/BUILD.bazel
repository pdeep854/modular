load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# The manifest-gate falsifier in examples/hexagon-ondevice synthesises skewed
# copies of the dispatch ABI manifest from the real file, and the device half of
# the queue transport is built against the same frame layout as the host half.
exports_files([
    "NPUDspQueueABI.h",
    "NPUKernels.def",
    "NPUQueueWire.h",
    # The def/host parity gate reads the host packer TU for the slot ceiling
    # and the selector law, the way the def/C gate reads mojo_npu_imp.c.
    "QuRTDeviceContext.cpp",
])

# The on-device NPU backend, reached over FastRPC.
#
# Unlike the discrete accelerator's driver plugin this is linked statically
# rather than loaded through MODULAR_DRIVER_PLUGINS: the plugin seam hands back
# a `M::Driver::Device *` the plugin itself constructed, which needs MLRT's C++
# base classes resolved when the plugin loads. That works on a POSIX host via
# RTLD_GLOBAL; a Windows host has no lazy cross-image binding, so the backend is
# linked into the same image and `Device::create` calls `createNPUDevice`
# directly. It has to be a direct call: a self-registering initializer does not
# survive the `cc_static_library` that stages this for Windows, which flattens
# the closure into a plain archive where the linker drops any object no symbol
# refers to -- past that point `alwayslink` no longer protects it.
cc_library(
    name = "QuRTDeviceContext",
    srcs = [
        "NPUDispatchRecorder.cpp",
        "NPUQueueTransport.cpp",
        "QuRTDeviceContext.cpp",
        "QuRTDriver.cpp",
    ],
    hdrs = [
        "NPUDispatchRecorder.h",
        "NPUDspQueueABI.h",
        "NPUQueueTransport.h",
        "QuRTDeviceContext.h",
        "QuRTDriver.h",
    ],
    # Expanded rather than included once, and expanded again on the device side:
    # examples/hexagon-ondevice/build.sh stages it beside the skel sources.
    textual_hdrs = ["NPUKernels.def"],
    deps = [
        ":npu_constant_ranges",
        ":npu_queue_wire",
        "@@+llvm_configure+llvm-project//llvm:Support",
        "@@//MLRT:Driver/DeviceContextAPI",
        "@@//Support:Base",
        "@@//Support:DLFcn",
    ],
    alwayslink = True,
)

# The loader-declared constant-range registry behind the weights-NOFLUSH
# classification. Its own library so the provenance predicate is testable
# without dragging in MLRT, and so the exec drivers' C calls and the backend's
# query resolve to the one registry.
cc_library(
    name = "npu_constant_ranges",
    srcs = ["npu_constant_ranges.cpp"],
    hdrs = ["npu_constant_ranges.h"],
    tags = ["no-mypy"],
)

# The queue frame layout and the vendor descriptor's restated ABI, so the device
# half of the transport can be built and tested against the same headers the
# host packs with, without dragging in MLRT.
cc_library(
    name = "npu_queue_wire",
    hdrs = [
        "NPUDspQueueABI.h",
        "NPUQueueWire.h",
    ],
    includes = ["."],
    tags = ["no-mypy"],
)

# The address split a launch sends for each buffer operand: the allocation the
# device maps, and the offset it adds back. Arithmetic over the allocation map,
# so it needs neither FastRPC nor a device and runs on any host.
cc_test(
    name = "npu_launch_offsets_test",
    srcs = ["npu_launch_offsets_test.cpp"],
    tags = ["no-mypy"],
)

# The weights-NOFLUSH provenance predicate through the same C seam the backend
# queries: declared ranges cover, everything else refuses. Pure interval
# arithmetic, no FastRPC, no device.
cc_test(
    name = "npu_constant_ranges_test",
    srcs = ["npu_constant_ranges_test.cpp"],
    tags = ["no-mypy"],
    deps = [":npu_constant_ranges"],
)

# A stand-in for the vendor FastRPC library, bound through the
# MODULAR_NPU_TRANSPORT_LIB seam. Test-only: it re-decodes the generic entry
# point's wire layout and writes a deterministic pattern where a kernel would
# write, so the dispatch path (and its recorder) can run on a host with no NPU.
cc_binary(
    name = "npu_fake_transport",
    testonly = True,
    srcs = ["npu_fake_transport.c"],
    linkshared = True,
)

# The same stand-in with remote_handle64_control compiled out, so the power
# vote's missing-symbol report is tested against a genuinely absent dlsym
# rather than a stub that answers differently.
cc_binary(
    name = "npu_fake_transport_no_control",
    testonly = True,
    srcs = ["npu_fake_transport.c"],
    linkshared = True,
    local_defines = ["NPU_FAKE_NO_CONTROL=1"],
)

# The per-dispatch IO recorder, driven through the real launch path against the
# stand-in transport: every dispatch captured in order, operand tuples as
# packed, hashes stable within and across processes, and — the control — a
# recorded run's buffer bytes identical to an unrecorded run's.
# The perf timeline, driven through the real launch path against a stand-in
# transport that blocks for a known time and reports a known device figure: the
# spans have to put injected time back where it was spent, above all the gap
# BETWEEN launches, which on this transport is device idle. The control is that
# the same chain with the timeline off writes nothing.
cc_test(
    name = "npu_perf_timeline_test",
    srcs = ["npu_perf_timeline_test.cpp"],
    data = [":npu_fake_transport"],
    env = {
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "false",
        "NPU_FAKE_TRANSPORT": "$(rootpath :npu_fake_transport)",
    },
    tags = ["no-mypy"],
    deps = [
        ":QuRTDeviceContext",
        "@@//MLRT:Driver/DeviceContextImpl",
        "@@//Support:Base",
    ],
)

