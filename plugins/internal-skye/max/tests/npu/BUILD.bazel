load("@@//bazel:api.bzl", "mojo_test_environment")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

# Sourced by the mach_bundle eligibility test the way the examples package
# exports npu_weight_repack.py: the consumer-table grammar and the selection
# rule must be pinned by one test even though they live in two packages.
exports_files(["flux_stager_inventory.py"])

# `custom_extensions` precompiles the registration package in-process, so the
# import path has to carry the packages it imports.
mojo_test_environment(
    name = "_mojo_env",
    testonly = True,
    data = [
        "@@//max:builtin_kernels",
        "@@//max:builtin_primitives",
        "@@//max:extensibility",
    ],
)

_ENV = {
    "MODULAR_MOJO_MAX_COMPILERRT_PATH": "$(COMPILER_RT_PATH)",
    "MODULAR_MOJO_MAX_DRIVER_PATH": "$(MOJO_BINARY_PATH)",
    "MODULAR_MOJO_MAX_IMPORT_PATH": "$(COMPUTED_IMPORT_PATH)",
    "MODULAR_MOJO_MAX_LINKER_DRIVER": "$(MOJO_LINKER_DRIVER)",
    "MODULAR_MOJO_MAX_LLD_PATH": "$(LLD_PATH)",
    "MODULAR_MOJO_MAX_SHARED_LIBS": "$(COMPUTED_LIBS)",
    "MODULAR_MOJO_MAX_SYSTEM_LIBS": "$(MOJO_LINKER_SYSTEM_LIBS)",
}

# The census drives its probe in a subprocess per op, so the probe travels as a
# source of that target rather than as a test of its own.
_EXTRA_SRCS = {
    "test_npu_op_disposition.py": ["npu_op_disposition_probe.py"],
    "test_npu_op_disposition_census.py": ["npu_op_disposition_probe.py"],
}

# The disposition test audits every sibling's `Graph(...)` calls by globbing
# next to its own `__file__`. Declared so the audited set is the whole package
# wherever the test runs: an execution mode that materializes only declared
# inputs (remote, for one) would otherwise hand the glob just this target's
# sources and pass the audit over them vacuously.
_EXTRA_DATA = {
    "test_npu_op_disposition.py": glob(["test_npu_*.py"]),
}

# The exhaustive sweep is a research target, not a presubmit: it compiles one
# graph per op in a process of its own. `test_npu_op_disposition` is the landed
# guard, carrying the rungs the sweep measured.
_MANUAL = ["test_npu_op_disposition_census.py"]

# One compile per case in a process of its own, so both probing targets need the
# longer budget. Sharding them is not an option: `pytest_runner` does not accept
# bazel's `--shard-id`/`--num-shards`.
_SLOW = [
    "test_npu_op_disposition.py",
    "test_npu_op_disposition_census.py",
]

# The two probing sweeps outgrew even the `long` ceiling off the Macs: both
# measured past 900 s on the x86 fleet box and on remote executors alike
# (2026-08-16; the ARM hosts finish in minutes). `eternal` still catches a
# genuine hang while letting slower hosts run the same 143-target gate as the
# Mac seat. Recipe and evidence: .agentwork/flux-npu/fleet/BOX_GATE.md.
_SLOWEST = [
    "test_npu_op_disposition_census.py",
    "test_npu_slice_materialization.py",
]

# No `target_compatible_with`: virtual-device mode enumerates the NPU, so these
# compile on any host. Unlike `../qaic`, they need no device and no driver
# plugin.
#
# Separate targets because `set_virtual_cpu_target` is process-global: the
# cross-compile case would retarget every compile that followed it.
[
    py_test(
        name = test_file[:-3],
        size = "large" if test_file in _SLOW else "medium",
        # The slice census compiles ~40 graphs in one process, which does not
        # fit the timeout `size` implies.
        timeout = "eternal" if test_file in _SLOWEST else "long",
        srcs = [
            test_file,
            "@@//bazel/internal:pytest_runner",
        ] + _EXTRA_SRCS.get(test_file, []),
        args = [
            "$(rootpath " + test_file + ")",
            "-svv",
            "--color=yes",
        ],
        data = [
            "_mojo_env",
            "npu_slice_materialization_probe.py",
            "//max/kernels/src/hexagon_ondevice:hexagon_ondevice_srcs",
        ] + _EXTRA_DATA.get(test_file, []),
        env = _ENV,
        main = "pytest_runner.py",
        tags = ["npu"] + (["manual"] if test_file in _MANUAL else []),
        toolchains = [
            "@@//bazel/internal:current_gpu_toolchain",
            "_mojo_env",
        ],
        deps = [
            "@@//max/python/max/driver",
            "@@//max/python/max/dtype",
            "@@//max/python/max/engine",
            "@@//max/python/max/graph",
            "@@//max/python/max/nn",
            "@@rules_pycross++lock_file+modular_pip_lock_file_repo//deps:pytest",
        ],
    )
    for test_file in [
        "test_npu_graph_add_windows.py",
        "test_npu_graph_attention_chain.py",
        "test_npu_graph_attention_chain_windows.py",
        "test_npu_graph_batch_matmul.py",
        "test_npu_graph_cast.py",
        "test_npu_graph_constfold_windows.py",
        "test_npu_graph_conv_mid.py",
        "test_npu_graph_conv_mid_windows.py",
        "test_npu_graph_gated_residual.py",
        "test_npu_graph_gated_residual_windows.py",
        "test_npu_graph_groupnorm.py",
        "test_npu_graph_groupnorm_weights_windows.py",
        "test_npu_graph_groupnorm_windows.py",
        "test_npu_graph_layernorm.py",
        "test_npu_graph_layernorm_windows.py",
        "test_npu_graph_matmul.py",
        "test_npu_graph_mha_no_cache.py",
        "test_npu_graph_modulation.py",
        "test_npu_graph_modulation_fp16_windows.py",
        "test_npu_graph_modulation_symbolic_windows.py",
        "test_npu_graph_modulation_windows.py",
        "test_npu_graph_movement.py",
        "test_npu_op_disposition.py",
        "test_npu_op_disposition_census.py",
        "test_npu_graph_matmul_windows.py",
        "test_npu_graph_rms_norm.py",
        "test_npu_graph_rms_norm_windows.py",
        "test_npu_graph_rope.py",
        "test_npu_graph_rope_windows.py",
        "test_npu_graph_sincos_tables.py",
        "test_npu_graph_softmax.py",
        "test_npu_slice_materialization.py",
        "test_npu_unregistered_op.py",
    ]
]

# Its own rule rather than a row in the list above: this one stages a whole
# pipeline architecture, so it carries the flux2 dependency the rest do not.
# It stages and never compiles. The NPU compile is cheap and is
# `test_flux_denoise_whole_graph`'s job below; the compile that could yield
# this number directly needs a GPU target (the one device where every kernel
# elaborates) and has never completed -- eight remote attempts were OOM-killed
# at 48.7 to 59.5 GiB, one under an 88 GiB `test.EstimatedMemory` declaration
# the scheduler accepted. That `exec_properties` key is how a raw py_test asks
# for memory (`get_resources_exec_properties` is reachable only from
# `modular_py_test`/`mojo_test`); no target in this package needs it.
py_test(
    name = "test_flux_activation_pool",
    size = "large",
    srcs = [
        "test_flux_activation_pool.py",
        "@@//bazel/internal:pytest_runner",
    ],
    args = [
        "$(rootpath test_flux_activation_pool.py)",
        "-svv",
        "--color=yes",
    ],
    data = ["_mojo_env"],
    env = _ENV,
    main = "pytest_runner.py",
    tags = ["npu"],
    toolchains = [
        "@@//bazel/internal:current_gpu_toolchain",
        "_mojo_env",
    ],
    deps = [
        "@@//max/python/max/driver",
        "@@//max/python/max/dtype",
        "@@//max/python/max/engine",
        "@@//max/python/max/graph",
        "@@//max/python/max/pipelines/architectures/flux2",
        "@@rules_pycross++lock_file+modular_pip_lock_file_repo//deps:pytest",
    ],
)

